{
  "manifest_version": 3,
  "name": "Shadowing Studio for YouTube",
  "short_name": "Shadowing Studio",
  "version": "1.0.0",
  "description": "Loop any YouTube sentence, record your shadowing attempts, compare them and keep a local practice library.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Open Shadowing Studio",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "side_panel": { "default_path": "sidepanel/index.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "permissions": ["sidePanel", "storage", "downloads", "unlimitedStorage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
