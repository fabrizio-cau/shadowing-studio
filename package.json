{
  "name": "youtube-shadowing-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension for shadowing practice on YouTube: loop segments, record attempts, compare, export.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "fix-webm-duration": "^1.0.6",
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^31.0.0",
    "playwright-core": "^1.65.0",
    "typescript": "5.9",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
